# Dinner Ideas - Environment Variables
# Copy this file to .env.development for local development settings.
# Never commit .env files with real secrets!

# Optional: Override the API base path.
# In production, the app uses relative URL '/api' (routed through CloudFront).
# Set this only for local development if not using the Vite dev proxy.
# VITE_APP_API_ENDPOINT=https://your-api-gateway-url.execute-api.us-west-1.amazonaws.com/prod

# Vite dev server proxy target for /api requests during local development.
# Points to your API Gateway stage or a local backend instance.
# VITE_API_TARGET=https://your-api-gateway-url.execute-api.us-west-1.amazonaws.com/prod

